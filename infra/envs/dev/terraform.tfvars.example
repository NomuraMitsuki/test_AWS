project_name      = "attendance"
environment       = "dev"
aws_region        = "ap-northeast-1"
github_org_repo   = "NomuraMitsuki/test_AWS"
db_instance_class = "db.t4g.micro"
# alarm_email     = "you@example.com"

# Amplify（GitHub トークンは apply 前に設定。空でも validate 可）
amplify_repository_url = "https://github.com/NomuraMitsuki/test_AWS"
amplify_branch_name    = "main"
# amplify_github_access_token = "ghp_..."

# API CORS（Amplify オリジンは apply 後に amplify_default_branch_url を設定）
cors_allow_localhost = true
# cors_amplify_origin = "https://main.xxxx.amplifyapp.com"
